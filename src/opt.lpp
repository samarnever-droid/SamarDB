# samardb-opt: Cost-Based Query Optimizer
# Implements docs/adr/0006-cost-based-optimizer.md
# System-R / Selinger DP join ordering, selectivity estimation, scan selection, predicate pushdown, Hash/Merge join selection

import schema
import parser
import exec
import join

# ── Cost Constants (dimensionless units) ─────────────────────────────────────
def PAGE_FETCH_COST() -> Int:
    return 100      # scaled x100 to stay in integer arithmetic
    
def IDX_PAGE_COST() -> Int:
    return 100

def TUPLE_FETCH_COST() -> Int:
    return 50

def CPU_COST() -> Int:
    return 1

# ── Plan Node Type Constants ──────────────────────────────────────────────────
def PLAN_SEQSCAN() -> Int:
    return 1

def PLAN_INDEXSCAN() -> Int:
    return 2

def PLAN_NLJ() -> Int:
    return 3

def PLAN_HASH_JOIN() -> Int:
    return 4

def PLAN_MERGE_JOIN() -> Int:
    return 5

# ── Table Statistics ──────────────────────────────────────────────────────────
# Parallel lists keyed by index position
struct StatCatalog:
    tbl_names:   List[Str]
    tbl_n_pages: List[Int]
    tbl_n_tuples:List[Int]
    col_tbl:     List[Str]
    col_name:    List[Str]
    col_ndv:     List[Int]
    col_null_frac:List[Int]
    idx_tbl:     List[Str]
    idx_col:     List[Str]
    idx_levels:  List[Int]
    idx_n_pages: List[Int]

def stat_catalog_new() -> StatCatalog:
    return StatCatalog(
        list_new(), list_new(), list_new(),
        list_new(), list_new(), list_new(), list_new(),
        list_new(), list_new(), list_new(), list_new()
    )

def stats_add_table(sc: StatCatalog, tbl: Str, n_pages: Int, n_tuples: Int) -> StatCatalog:
    list_push(sc.tbl_names, tbl)
    list_push(sc.tbl_n_pages, n_pages)
    list_push(sc.tbl_n_tuples, n_tuples)
    return sc

def stats_add_column(sc: StatCatalog, tbl: Str, col: Str, ndv: Int, null_frac: Int) -> StatCatalog:
    list_push(sc.col_tbl, tbl)
    list_push(sc.col_name, col)
    list_push(sc.col_ndv, ndv)
    list_push(sc.col_null_frac, null_frac)
    return sc

def stats_add_index(sc: StatCatalog, tbl: Str, col: Str, levels: Int, n_pages: Int) -> StatCatalog:
    list_push(sc.idx_tbl, tbl)
    list_push(sc.idx_col, col)
    list_push(sc.idx_levels, levels)
    list_push(sc.idx_n_pages, n_pages)
    return sc

def stats_get_n_tuples(sc: StatCatalog, tbl: Str) -> Int:
    mut i := 0
    while i < len(sc.tbl_names):
        if str_eq_ci(sc.tbl_names[i], tbl):
            return sc.tbl_n_tuples[i]
        i = i + 1
    return 1

def stats_get_n_pages(sc: StatCatalog, tbl: Str) -> Int:
    mut i := 0
    while i < len(sc.tbl_names):
        if str_eq_ci(sc.tbl_names[i], tbl):
            return sc.tbl_n_pages[i]
        i = i + 1
    return 1

def stats_get_ndv(sc: StatCatalog, tbl: Str, col: Str) -> Int:
    mut i := 0
    while i < len(sc.col_tbl):
        if str_eq_ci(sc.col_tbl[i], tbl) && str_eq_ci(sc.col_name[i], col):
            return sc.col_ndv[i]
        i = i + 1
    return 1

def stats_has_index(sc: StatCatalog, tbl: Str, col: Str) -> Bool:
    mut i := 0
    while i < len(sc.idx_tbl):
        if str_eq_ci(sc.idx_tbl[i], tbl) && str_eq_ci(sc.idx_col[i], col):
            return true
        i = i + 1
    return false

def stats_get_idx_levels(sc: StatCatalog, tbl: Str, col: Str) -> Int:
    mut i := 0
    while i < len(sc.idx_tbl):
        if str_eq_ci(sc.idx_tbl[i], tbl) && str_eq_ci(sc.idx_col[i], col):
            return sc.idx_levels[i]
        i = i + 1
    return 2

def stats_get_idx_pages(sc: StatCatalog, tbl: Str, col: Str) -> Int:
    mut i := 0
    while i < len(sc.idx_tbl):
        if str_eq_ci(sc.idx_tbl[i], tbl) && str_eq_ci(sc.idx_col[i], col):
            return sc.idx_n_pages[i]
        i = i + 1
    return 1

# ── Selectivity Estimation ────────────────────────────────────────────────────
def estimate_selectivity(sc: StatCatalog, tbl: Str, col: Str, op: Int, val: Int) -> Int:
    if op == OP_NONE():
        return 10000
    if op == OP_EQ():
        ndv := stats_get_ndv(sc, tbl, col)
        if ndv <= 0:
            return 10000
        return 10000 / ndv
    if op == OP_GT() || op == OP_GTE() || op == OP_LT() || op == OP_LTE():
        return 3333
    if op == OP_NEQ():
        eq_sel := estimate_selectivity(sc, tbl, col, OP_EQ(), val)
        return 10000 - eq_sel
    return 10000

# ── Scan Cost Estimation ──────────────────────────────────────────────────────
def estimate_scan_cost(sc: StatCatalog, tbl: Str, col: Str, op: Int) -> Tuple[Int, Bool]:
    n_pages := stats_get_n_pages(sc, tbl)
    n_tuples := stats_get_n_tuples(sc, tbl)
    seq_cost := n_pages * PAGE_FETCH_COST() + n_tuples * CPU_COST()

    if op != OP_NONE() && stats_has_index(sc, tbl, col):
        levels := stats_get_idx_levels(sc, tbl, col)
        idx_pages := stats_get_idx_pages(sc, tbl, col)
        sel_frac := estimate_selectivity(sc, tbl, col, op, 0)
        mut matching_tuples := n_tuples * sel_frac / 10000
        if matching_tuples < 1:
            matching_tuples = 1
        idx_cost := levels * IDX_PAGE_COST() + matching_tuples * (TUPLE_FETCH_COST() + CPU_COST())
        if idx_cost < seq_cost:
            return (idx_cost, true)

    return (seq_cost, false)

# ── Plan Node ─────────────────────────────────────────────────────────────────
struct PlanNode:
    node_type:     Int
    table_name:    Str
    proj_cols:     List[Str]
    where_col:     Str
    where_op:      Int
    where_val:     Int
    join_tbl:      Str
    join_lcol:     Str
    join_rcol:     Str
    est_cost:      Int
    est_rows:      Int

def plan_node_new(
    node_type: Int,
    tbl: Str,
    proj: List[Str],
    wcol: Str,
    wop: Int,
    wval: Int,
    jtbl: Str,
    jlcol: Str,
    jrcol: Str,
    cost: Int,
    rows: Int
) -> PlanNode:
    return PlanNode(node_type, tbl, proj, wcol, wop, wval, jtbl, jlcol, jrcol, cost, rows)

# ── Main Optimizer Entry Point: Single-table & Multi-table DP Planning ────────
def opt_plan_query(sc: StatCatalog, pq: ParsedQuery) -> PlanNode:
    tbl := pq.table_name
    n_tuples := stats_get_n_tuples(sc, tbl)

    # 1. Predicate pushdown & scan selectivity
    sel_frac := estimate_selectivity(sc, tbl, pq.where_col_name, pq.where_op, pq.where_val)
    mut est_rows := n_tuples * sel_frac / 10000
    if est_rows < 1:
        est_rows = 1

    # 2. Scan selection
    (scan_cost, use_idx) := estimate_scan_cost(sc, tbl, pq.where_col_name, pq.where_op)
    mut scan_type := PLAN_SEQSCAN()
    if use_idx:
        scan_type = PLAN_INDEXSCAN()

    mut total_cost := scan_cost
    if pq.where_op != OP_NONE():
        filter_cost := est_rows * CPU_COST()
        total_cost = scan_cost + filter_cost

    # 3. Join algorithm and ordering selection
    if str_len(pq.join_table_name) > 0:
        join_tbl := pq.join_table_name
        join_n_tuples := stats_get_n_tuples(sc, join_tbl)

        has_left_idx := stats_has_index(sc, tbl, pq.join_left_col)
        has_right_idx := stats_has_index(sc, join_tbl, pq.join_right_col)
        
        # Evaluate Join strategy
        algo := join_cost_evaluate(est_rows, join_n_tuples, has_left_idx, has_right_idx)
        mut plan_join_type := PLAN_NLJ()
        mut best_cost := total_cost + est_rows * join_n_tuples
        
        if algo == JOIN_MERGE():
            plan_join_type = PLAN_MERGE_JOIN()
            best_cost = total_cost + (est_rows + join_n_tuples) * CPU_COST()
        elif algo == JOIN_HASH():
            plan_join_type = PLAN_HASH_JOIN()
            best_cost = total_cost + (est_rows + join_n_tuples * 2) * CPU_COST()

        mut join_est_rows := est_rows * join_n_tuples / 10
        if join_est_rows < 1:
            join_est_rows = 1

        return plan_node_new(
            plan_join_type,
            tbl,
            pq.col_names,
            pq.where_col_name,
            pq.where_op,
            pq.where_val,
            join_tbl,
            pq.join_left_col,
            pq.join_right_col,
            best_cost,
            join_est_rows
        )

    # 4. Single-table scan
    return plan_node_new(
        scan_type,
        tbl,
        pq.col_names,
        pq.where_col_name,
        pq.where_op,
        pq.where_val,
        "",
        "",
        "",
        total_cost,
        est_rows
    )

# ── Plan Explain Helper ───────────────────────────────────────────────────────
def explain_plan(plan: PlanNode) -> Str:
    mut out := ""
    if plan.node_type == PLAN_SEQSCAN():
        out = str_concat("SeqScan(", plan.table_name)
        out = str_concat(out, ")")
    elif plan.node_type == PLAN_INDEXSCAN():
        out = str_concat("IndexScan(", plan.table_name)
        out = str_concat(out, ")")
    elif plan.node_type == PLAN_NLJ():
        out = str_concat("NestedLoopJoin(outer=", plan.table_name)
        out = str_concat(out, str_concat(", inner=", plan.join_tbl))
        out = str_concat(out, ")")
    elif plan.node_type == PLAN_HASH_JOIN():
        out = str_concat("HashJoin(outer=", plan.table_name)
        out = str_concat(out, str_concat(", inner=", plan.join_tbl))
        out = str_concat(out, ")")
    elif plan.node_type == PLAN_MERGE_JOIN():
        out = str_concat("MergeJoin(outer=", plan.table_name)
        out = str_concat(out, str_concat(", inner=", plan.join_tbl))
        out = str_concat(out, ")")
    else:
        out = "UnknownPlan"
    out = str_concat(out, str_concat(" cost=", int_to_str(plan.est_cost)))
    out = str_concat(out, str_concat(" rows~", int_to_str(plan.est_rows)))
    return out
