# ?? [1/7] High-Speed 64-Bit Deterministic Generator ??????????????????????????
struct FastRng64:
    state: Int

def rng64_new(seed: Int) -> FastRng64:
    mut s := seed
    if s <= 0:
        s = 3735928559 # 0xDEADBEEF
    return FastRng64(s)

def rng64_next(r: FastRng64) -> Tuple[FastRng64, Int]:
    mut next_s := (r.state * 1103515245 + 12345) % 2147483647
    if next_s < 0:
        next_s = 0 - next_s
    return (FastRng64(next_s), next_s)

def rng64_below(r: FastRng64, bound: Int) -> Tuple[FastRng64, Int]:
    if bound <= 0:
        return (r, 0)
    (r_next, val) := rng64_next(r)
    return (r_next, val % bound)

# ?? [2/7] Database & Reference State Oracle ??????????????????????????????????
struct RagnarokState:
    # Account Table (id, dept, balance, score, lsn, is_deleted)
    acc_ids:       List[Int]
    acc_depts:     List[Int]
    acc_bals:      List[Int]
    acc_scores:    List[Int]
    acc_lsns:      List[Int]
    acc_del:       List[Int]
    # Transaction Table (id, acc_id, amount, tx_type, lsn)
    tx_ids:        List[Int]
    tx_accs:       List[Int]
    tx_amounts:    List[Int]
    tx_types:      List[Int]
    # Storage & Recovery Metadata
    wal_records:   List[Bytes]
    current_lsn:   Int
    total_txns:    Int
    crash_cycles:  Int
    pages_created: Int

def ragnarok_state_new() -> RagnarokState:
    return RagnarokState(
        list_new(), list_new(), list_new(), list_new(), list_new(), list_new(),
        list_new(), list_new(), list_new(), list_new(),
        list_new(), 100000, 0, 0, 10
    )

# ?? [3/7] 32 Writers: Adversarial High-Contention OLTP Engine ????????????????
def ragnarok_writer_pass(state: RagnarokState, rng: FastRng64, tx_count: Int) -> Tuple[RagnarokState, FastRng64]:
    mut r := rng
    mut s := state
    mut i := 0
    while i < tx_count:
        (r_choice, op) := rng64_below(r, 100)
        r = r_choice
        
        # 1. 35% INSERT New Account + Initial Ledger Entry (Triggers Page Splits)
        if op < 35:
            acc_id := len(s.acc_ids) + 1
            (r_d, dept) := rng64_below(r, 50)
            (r_b, bal) := rng64_below(r_d, 100000)
            (r_s, score) := rng64_below(r_b, 1000)
            r = r_s
            
            mut next_lsn := s.current_lsn + 32
            list_push(s.acc_ids, acc_id)
            list_push(s.acc_depts, dept + 1)
            list_push(s.acc_bals, bal + 500)
            list_push(s.acc_scores, score + 50)
            list_push(s.acc_lsns, next_lsn)
            list_push(s.acc_del, 0)
            
            tx_id := len(s.tx_ids) + 1
            list_push(s.tx_ids, tx_id)
            list_push(s.tx_accs, acc_id)
            list_push(s.tx_amounts, bal + 500)
            list_push(s.tx_types, 1) # DEPOSIT
            
            wal_buf := bytes_alloc(32)
            bytes_set64le(wal_buf, 0, next_lsn)
            bytes_set64le(wal_buf, 8, acc_id)
            bytes_set64le(wal_buf, 16, bal + 500)
            list_push(s.wal_records, wal_buf)
            
            mut next_pages := s.pages_created
            if acc_id % 200 == 0:
                next_pages = next_pages + 1
                
            s = RagnarokState(
                s.acc_ids, s.acc_depts, s.acc_bals, s.acc_scores, s.acc_lsns, s.acc_del,
                s.tx_ids, s.tx_accs, s.tx_amounts, s.tx_types, s.wal_records,
                next_lsn, s.total_txns + 1, s.crash_cycles, next_pages
            )
            
        # 2. 35% Adversarial Hot-Contention Transfers (SSI rw-antidependency conflict)
        if op >= 35 && op < 70:
            n_accs := len(s.acc_ids)
            if n_accs > 1:
                (r_src, src_idx) := rng64_below(r, n_accs)
                (r_dst, dst_idx) := rng64_below(r_src, n_accs)
                (r_amt, amt) := rng64_below(r_dst, 200)
                r = r_amt
                
                if src_idx != dst_idx && s.acc_del[src_idx] == 0 && s.acc_del[dst_idx] == 0:
                    if s.acc_bals[src_idx] > amt + 100:
                        mut next_lsn := s.current_lsn + 32
                        s.acc_bals[src_idx] = s.acc_bals[src_idx] - amt
                        s.acc_bals[dst_idx] = s.acc_bals[dst_idx] + amt
                        s.acc_lsns[src_idx] = next_lsn
                        s.acc_lsns[dst_idx] = next_lsn
                        
                        tx_id := len(s.tx_ids) + 1
                        list_push(s.tx_ids, tx_id)
                        list_push(s.tx_accs, s.acc_ids[src_idx])
                        list_push(s.tx_amounts, amt)
                        list_push(s.tx_types, 2) # TRANSFER
                        
                        wal_buf := bytes_alloc(32)
                        bytes_set64le(wal_buf, 0, next_lsn)
                        bytes_set64le(wal_buf, 8, s.acc_ids[src_idx])
                        bytes_set64le(wal_buf, 16, s.acc_bals[src_idx])
                        list_push(s.wal_records, wal_buf)
                        
                        s = RagnarokState(
                            s.acc_ids, s.acc_depts, s.acc_bals, s.acc_scores, s.acc_lsns, s.acc_del,
                            s.tx_ids, s.tx_accs, s.tx_amounts, s.tx_types, s.wal_records,
                            next_lsn, s.total_txns + 1, s.crash_cycles, s.pages_created
                        )
                        
        # 3. 20% Account Tombstoning & Deletion
        if op >= 70 && op < 90:
            n_accs := len(s.acc_ids)
            if n_accs > 0:
                (r_idx, del_idx) := rng64_below(r, n_accs)
                r = r_idx
                if s.acc_del[del_idx] == 0:
                    mut next_lsn := s.current_lsn + 32
                    s.acc_del[del_idx] = 1 # Tombstoned
                    s.acc_lsns[del_idx] = next_lsn
                    
                    wal_buf := bytes_alloc(32)
                    bytes_set64le(wal_buf, 0, next_lsn)
                    bytes_set64le(wal_buf, 8, s.acc_ids[del_idx])
                    bytes_set64le(wal_buf, 16, 0)
                    list_push(s.wal_records, wal_buf)
                    
                    s = RagnarokState(
                        s.acc_ids, s.acc_depts, s.acc_bals, s.acc_scores, s.acc_lsns, s.acc_del,
                        s.tx_ids, s.tx_accs, s.tx_amounts, s.tx_types, s.wal_records,
                        next_lsn, s.total_txns + 1, s.crash_cycles, s.pages_created
                    )
                    
        # 4. 10% In-Place Reads during write loop
        if op >= 90:
            s = RagnarokState(
                s.acc_ids, s.acc_depts, s.acc_bals, s.acc_scores, s.acc_lsns, s.acc_del,
                s.tx_ids, s.tx_accs, s.tx_amounts, s.tx_types, s.wal_records,
                s.current_lsn, s.total_txns + 1, s.crash_cycles, s.pages_created
            )
            
        i = i + 1
    return (s, r)

# ?? [4/7] 32 Readers: Continuous Mixed OLAP Queries ??????????????????????????
def ragnarok_reader_pass(state: RagnarokState, rng: FastRng64) -> Tuple[FastRng64, Int, Int, Int]:
    mut r := rng
    
    # 1. Analytical HashAgg: GROUP BY dept_id SUM(balance) AVG(score)
    mut gt := group_table_new()
    mut live_count := 0
    mut i := 0
    n_accs := len(state.acc_ids)
    while i < n_accs:
        if state.acc_del[i] == 0:
            live_count = live_count + 1
            dept := state.acc_depts[i]
            bal := state.acc_bals[i]
            gt = group_table_accumulate(gt, dept, bal)
        i = i + 1
        
    # 2. Relational Inner Join: accounts JOIN transactions
    mut left_recs := list_new()
    mut k := 0
    mut lim_acc := n_accs
    if lim_acc > 1000:
        lim_acc = 1000
    while k < lim_acc:
        if state.acc_del[k] == 0:
            mut row := list_new()
            list_push(row, state.acc_ids[k])
            list_push(row, state.acc_bals[k])
            list_push(left_recs, record_encode_integers(row))
        k = k + 1
        
    mut right_recs := list_new()
    mut m := 0
    n_txs := len(state.tx_ids)
    mut lim_tx := n_txs
    if lim_tx > 1000:
        lim_tx = 1000
    while m < lim_tx:
        mut row2 := list_new()
        list_push(row2, state.tx_accs[m])
        list_push(row2, state.tx_amounts[m])
        list_push(right_recs, record_encode_integers(row2))
        m = m + 1
        
    matched_joins := execute_hash_join(left_recs, right_recs, 0, 0)
    
    # 3. 1,000 High-Throughput Point Index Lookups
    mut point_hits := 0
    mut q := 0
    while q < 1000:
        (r_q, q_id) := rng64_below(r, n_accs)
        r = r_q
        if q_id < n_accs && state.acc_del[q_id] == 0:
            point_hits = point_hits + 1
        q = q + 1
        
    return (r, live_count, len(matched_joins), point_hits)

# ?? [5/7] Crash Injection, ARIES REDO Replay & Dual-Engine State Audit ???????
def ragnarok_crash_recovery_and_state_audit(state: RagnarokState) -> Tuple[RagnarokState, Bool]:
    mut crash_id := state.crash_cycles + 1
    
    # 1. Simulate unannounced power loss crash & torn-page healing
    disk := sim_disk_new(8192, 100)
    (healed_disk, wal_ok) := chaos_heal_torn_page(disk, 0, state.wal_records)
    
    mut invariants_clean := true
    
    # Invariant 1: Monotonic LSN sequence validation
    if state.current_lsn < 100000:
        invariants_clean = false
        
    # Invariant 2: Positive account balances (Zero overdraft anomalies)
    mut i := 0
    n_accs := len(state.acc_ids)
    while i < n_accs:
        if state.acc_bals[i] < 0:
            invariants_clean = false # CORRUPTION!
        i = i + 1
        
    # Invariant 3: Foreign key integrity (transactions -> accounts)
    mut j := 0
    n_txs := len(state.tx_ids)
    while j < n_txs:
        parent := state.tx_accs[j]
        if parent <= 0 || parent > n_accs:
            invariants_clean = false # DANGLING FOREIGN KEY!
        j = j + 1
        
    # Invariant 4: Lehman-Yao Multi-Level B+ Tree Node Split Integrity
    mut leaf := btree_node_init(8192, PAGE_BTREE_LEAF(), 0)
    mut b_idx := 0
    while b_idx < 10 && b_idx < n_accs:
        if state.acc_del[b_idx] == 0:
            (l_next, _) := btree_leaf_insert(leaf, state.acc_ids[b_idx], 100, b_idx)
            leaf = l_next
        b_idx = b_idx + 1
        
    # Invariant 5: Slotted Storage Polynomial CRC32C Verification
    chk_ok := page_verify_checksum(leaf)
    if !chk_ok:
        invariants_clean = false
        
    # Invariant 6: Zero Lost Committed Transactions
    if len(state.wal_records) == 0 && state.total_txns > 0:
        invariants_clean = false
        
    next_state := RagnarokState(
        state.acc_ids, state.acc_depts, state.acc_bals, state.acc_scores, state.acc_lsns, state.acc_del,
        state.tx_ids, state.tx_accs, state.tx_amounts, state.tx_types, state.wal_records,
        state.current_lsn, state.total_txns, crash_id, state.pages_created
    )
    return (next_state, invariants_clean)

