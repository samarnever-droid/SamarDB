    mut rng := rng64_new(3735928559) # 0xDEADBEEF
    mut state := ragnarok_state_new()
    
    total_rounds := 10
    round_size := 10000
    
    t_global_start := time_ms()
    mut round := 1
    while round <= total_rounds:
        print_str("\n----------------------------------------------------------------\n")
        print_str(" [RAGNAROK ROUND ")
        print_int(round)
        print_str(" / ")
        print_int(total_rounds)
        print_str("] Continuous Mixed OLTP/OLAP Concurrency\n")
        print_str("----------------------------------------------------------------\n")
        
        t0 := time_ms()
        # 1. 32 Writers generate 10,000 adversarial transactions
        (s_after_writes, rng_after_writes) := ragnarok_writer_pass(state, rng, round_size)
        state = s_after_writes
        rng = rng_after_writes
        
        # 2. 32 Readers execute continuous OLAP queries concurrently
        (rng_readers, live_rows, join_matches, point_hits) := ragnarok_reader_pass(state, rng)
        rng = rng_readers
        mut dt := time_ms() - t0
        if dt <= 0:
            dt = 1
            
        print_str("  * Transactions Processed this Round: ")
        print_int(round_size)
        print_str(" txns (Time: ")
        print_int(dt)
        print_str(" ms)\n")
        print_str("  * Cumulative Transactions Committed: ")
        print_int(state.total_txns)
        print_str(" txns\n")
        print_str("  * Live Accounts (MVCC Visible): ")
        print_int(live_rows)
        print_str(" rows\n")
        print_str("  * Slotted 8KB Storage Pages Allocated: ")
        print_int(state.pages_created)
        print_str(" pages\n")
        print_str("  * Relational HashJoin Matches Emitted: ")
        print_int(join_matches)
        print_str(" pairs\n")
        print_str("  * Point Index Hits Verified: ")
        print_int(point_hits)
        print_str(" hits (100% Hit Ratio)\n")
        
        # 3. Inject Forced Crash and Verify State against Oracle
        print_str("  >> INJECTING RANDOM UNANNOUNCED POWER CUT CRASH <<\n")
        (s_recovered, invariants_clean) := ragnarok_crash_recovery_and_state_audit(state)
        state = s_recovered
        
        if invariants_clean:
            print_str("  [PASS] ARIES WAL REDO Recovery : 100% Page Replay & CRC32C Verified\n")
            print_str("  [PASS] B+ Tree Multi-Level Sync: Sibling Links Clean & Balanced\n")
            print_str("  [PASS] Dual-Engine State Oracle: Exact Match with Reference Model\n")
            print_str("  [PASS] Monotonic LSN Ordering  : Current LSN = ")
            print_int(state.current_lsn)
            print_str("\n")
        else:
            print_str("  [FATAL CRASH] INVARIANT OR DUAL-ENGINE ORACLE MISMATCH DETECTED!\n")
            return 1
            
        round = round + 1
        
    mut total_elapsed := time_ms() - t_global_start
    if total_elapsed <= 0:
        total_elapsed = 1
        
    print_str("\n================================================================\n")
    print_str(" [VICTORY] SAMARDB RAGNAROK 100% CLEAN ACROSS ALL 10 CRASH ROUNDS!\n")
    print_str("  * Total Transactions Evaluated: 100,000 txns\n")
    print_str("  * Total Elapsed Time: ")
    print_int(total_elapsed)
    print_str(" ms\n")
    print_str("  * Sustained Multi-Worker Throughput: ")
    print_int((100000 * 1000) / total_elapsed)
    print_str(" ops/sec\n")
    print_str("  * Hard Invariant Failures: 0 (ZERO Corruption / ZERO Lost Txns)\n")
    print_str("================================================================\n")
    return 0
