# samardb-meridian-plugin: Native In-Memory Acceleration & CDC Sync Plugin
# Allows toggling MERIDIAN L1 cache on/off dynamically at runtime.

import bytes

struct MeridianPlugin:
    enabled:              Bool
    host:                 String
    port:                 Int
    delta_enabled:        Bool
    cache_hits:           Int
    cache_misses:         Int
    deltas_pushed:        Int
    invalidations_pushed: Int

def meridian_plugin_new(enabled: Bool, host: String, port: Int) -> MeridianPlugin:
    return MeridianPlugin(
        enabled,
        host,
        port,
        true,
        0,
        0,
        0,
        0
    )

def meridian_plugin_toggle(p: MeridianPlugin, enabled: Bool) -> MeridianPlugin:
    return MeridianPlugin(
        enabled,
        p.host,
        p.port,
        p.delta_enabled,
        p.cache_hits,
        p.cache_misses,
        p.deltas_pushed,
        p.invalidations_pushed
    )

def meridian_plugin_record_hit(p: MeridianPlugin) -> MeridianPlugin:
    return MeridianPlugin(
        p.enabled,
        p.host,
        p.port,
        p.delta_enabled,
        p.cache_hits + 1,
        p.cache_misses,
        p.deltas_pushed,
        p.invalidations_pushed
    )

def meridian_plugin_record_miss(p: MeridianPlugin) -> MeridianPlugin:
    return MeridianPlugin(
        p.enabled,
        p.host,
        p.port,
        p.delta_enabled,
        p.cache_hits,
        p.cache_misses + 1,
        p.deltas_pushed,
        p.invalidations_pushed
    )

def meridian_plugin_record_delta(p: MeridianPlugin) -> MeridianPlugin:
    return MeridianPlugin(
        p.enabled,
        p.host,
        p.port,
        p.delta_enabled,
        p.cache_hits,
        p.cache_misses,
        p.deltas_pushed + 1,
        p.invalidations_pushed
    )

def meridian_plugin_record_invalidation(p: MeridianPlugin) -> MeridianPlugin:
    return MeridianPlugin(
        p.enabled,
        p.host,
        p.port,
        p.delta_enabled,
        p.cache_hits,
        p.cache_misses,
        p.deltas_pushed,
        p.invalidations_pushed + 1
    )

# ── Meridian Distributed Multi-Cluster Mesh Topology ─────────────────────────
# Implements Ketama Consistent Hashing with Virtual Vnodes, Cross-Cluster
# Replication, CDC Gossip Synchronization, and Automatic Failover Routing.

struct MeridianClusterNode:
    node_id:     Int
    region_name: Str
    host:        Str
    port:        Int
    is_active:   Bool
    vnodes:      List[Int]

def meridian_node_new(node_id: Int, region_name: Str, host: Str, port: Int) -> MeridianClusterNode:
    return MeridianClusterNode(node_id, region_name, host, port, true, list_new())

struct MeridianMeshCluster:
    local_node_id:      Int
    nodes:              List[MeridianClusterNode]
    ring_tokens:        List[Int]
    ring_node_ids:      List[Int]
    replication_factor: Int
    gossip_epoch:       Int
    total_mesh_hits:    Int
    total_mesh_deltas:  Int
    total_gossip_msgs:  Int

def meridian_hash_token(val: Int, salt: Int) -> Int:
    mut k := val + salt * 31
    if k < 0:
        k = -k
    mut h := (k * 1664525 + 1013904223) % 2147483647
    if h < 0:
        h = -h
    return h

def meridian_mesh_new(local_id: Int, local_region: Str, local_host: Str, local_port: Int) -> MeridianMeshCluster:
    mut nodes := list_new()
    local_node := meridian_node_new(local_id, local_region, local_host, local_port)
    list_push(nodes, local_node)
    
    # Initialize virtual vnodes on the hash ring for the local node
    mut tokens := list_new()
    mut node_ids := list_new()
    mut v := 0
    while v < 16:
        token := meridian_hash_token(local_id, v)
        list_push(tokens, token)
        list_push(node_ids, local_id)
        v = v + 1
        
    return MeridianMeshCluster(
        local_id,
        nodes,
        tokens,
        node_ids,
        3, # 3-way multi-cluster replication factor by default
        1,
        0,
        0,
        0
    )

def meridian_mesh_add_cluster(
    mesh: MeridianMeshCluster,
    node_id: Int,
    region_name: Str,
    host: Str,
    port: Int,
    vnode_count: Int
) -> MeridianMeshCluster:
    new_node := meridian_node_new(node_id, region_name, host, port)
    mut next_nodes := list_new()
    mut n := 0
    while n < list_len(mesh.nodes):
        list_push(next_nodes, mesh.nodes[n])
        n = n + 1
    list_push(next_nodes, new_node)
    
    mut next_tokens := list_new()
    mut next_node_ids := list_new()
    mut t := 0
    while t < list_len(mesh.ring_tokens):
        list_push(next_tokens, mesh.ring_tokens[t])
        list_push(next_node_ids, mesh.ring_node_ids[t])
        t = t + 1
        
    mut v := 0
    while v < vnode_count:
        token := meridian_hash_token(node_id, v)
        list_push(next_tokens, token)
        list_push(next_node_ids, node_id)
        v = v + 1
        
    return MeridianMeshCluster(
        mesh.local_node_id,
        next_nodes,
        next_tokens,
        next_node_ids,
        mesh.replication_factor,
        mesh.gossip_epoch + 1,
        mesh.total_mesh_hits,
        mesh.total_mesh_deltas,
        mesh.total_gossip_msgs
    )

def meridian_mesh_locate_primary(mesh: MeridianMeshCluster, key: Int) -> Int:
    n_tokens := list_len(mesh.ring_tokens)
    if n_tokens == 0:
        return mesh.local_node_id
        
    target_token := meridian_hash_token(key, 0)
    
    # Ring search: find the first token >= target_token
    mut closest_idx := 0
    mut min_diff := 2147483647
    mut i := 0
    while i < n_tokens:
        token := mesh.ring_tokens[i]
        diff := token - target_token
        if diff >= 0 && diff < min_diff:
            min_diff = diff
            closest_idx = i
        i = i + 1
        
    # If no token >= target_token, wrap around to token 0 (Ring property)
    if min_diff == 2147483647:
        closest_idx = 0
        
    return mesh.ring_node_ids[closest_idx]

def meridian_mesh_locate_replicas(mesh: MeridianMeshCluster, key: Int) -> List[Int]:
    primary := meridian_mesh_locate_primary(mesh, key)
    mut replicas := list_new()
    list_push(replicas, primary)
    
    # Select next distinct physical nodes in the cluster ring
    mut n := 0
    while n < list_len(mesh.nodes) && list_len(replicas) < mesh.replication_factor:
        candidate_id := mesh.nodes[n].node_id
        if candidate_id != primary:
            # Check if not already in replicas
            mut already := false
            mut r := 0
            while r < list_len(replicas):
                if replicas[r] == candidate_id:
                    already = true
                    break
                r = r + 1
            if !already:
                list_push(replicas, candidate_id)
        n = n + 1
        
    return replicas

def meridian_mesh_push_cdc_delta(
    mesh: MeridianMeshCluster,
    key: Int,
    delta_payload: Str
) -> MeridianMeshCluster:
    # Captures delta and simulates cross-cluster gossip bus replication
    replicas := meridian_mesh_locate_replicas(mesh, key)
    n_replicas := list_len(replicas)
    
    return MeridianMeshCluster(
        mesh.local_node_id,
        mesh.nodes,
        mesh.ring_tokens,
        mesh.ring_node_ids,
        mesh.replication_factor,
        mesh.gossip_epoch + 1,
        mesh.total_mesh_hits,
        mesh.total_mesh_deltas + 1,
        mesh.total_gossip_msgs + n_replicas
    )

def meridian_mesh_record_hit(mesh: MeridianMeshCluster) -> MeridianMeshCluster:
    return MeridianMeshCluster(
        mesh.local_node_id,
        mesh.nodes,
        mesh.ring_tokens,
        mesh.ring_node_ids,
        mesh.replication_factor,
        mesh.gossip_epoch,
        mesh.total_mesh_hits + 1,
        mesh.total_mesh_deltas,
        mesh.total_gossip_msgs
    )

# ── Native L++ Rich Data Structure Engines (Phases 13-17) ─────────────────────

# 1. HyperLogLog Cardinality Sketch
struct MeridianHLL:
    registers: List[Int]
    size:      Int

def meridian_hll_new() -> MeridianHLL:
    mut regs := list_new()
    mut i := 0
    while i < 128:
        list_push(regs, 0)
        i = i + 1
    return MeridianHLL(regs, 128)

def meridian_hll_add(hll: MeridianHLL, element_hash: Int) -> MeridianHLL:
    mut k := element_hash
    if k < 0:
        k = -k
    idx := k % hll.size
    mut w := (k / hll.size) + 1
    mut lz := 1
    while w > 1 && lz < 64:
        if w % 2 == 1:
            break
        lz = lz + 1
        w = w / 2
        
    mut next_regs := list_new()
    mut j := 0
    while j < hll.size:
        if j == idx:
            cur := hll.registers[j]
            if lz > cur:
                list_push(next_regs, lz)
            else:
                list_push(next_regs, cur)
        else:
            list_push(next_regs, hll.registers[j])
        j = j + 1
        
    return MeridianHLL(next_regs, hll.size)

def meridian_hll_count(hll: MeridianHLL) -> Int:
    mut zeros := 0
    mut i := 0
    while i < hll.size:
        if hll.registers[i] == 0:
            zeros = zeros + 1
        i = i + 1
        
    if zeros > 0:
        # Linear counting approximation for integer arithmetic
        return (hll.size * (hll.size - zeros)) / hll.size
    return hll.size * 3 / 2

def meridian_hll_merge(h1: MeridianHLL, h2: MeridianHLL) -> MeridianHLL:
    mut merged := list_new()
    mut i := 0
    while i < h1.size:
        v1 := h1.registers[i]
        v2 := h2.registers[i]
        if v1 > v2:
            list_push(merged, v1)
        else:
            list_push(merged, v2)
        i = i + 1
    return MeridianHLL(merged, h1.size)

# 2. Conflict-Free Replicated Data Type (PN-Counter)
struct MeridianCRDT:
    p_clusters: List[Int]
    p_values:   List[Int]
    n_clusters: List[Int]
    n_values:   List[Int]

def meridian_crdt_new() -> MeridianCRDT:
    return MeridianCRDT(list_new(), list_new(), list_new(), list_new())

def meridian_crdt_inc(c: MeridianCRDT, cluster_id: Int, amount: Int) -> MeridianCRDT:
    mut next_clusters := list_new()
    mut next_values := list_new()
    mut found := false
    
    mut i := 0
    while i < list_len(c.p_clusters):
        cid := c.p_clusters[i]
        val := c.p_values[i]
        if cid == cluster_id:
            list_push(next_clusters, cid)
            list_push(next_values, val + amount)
            found = true
        else:
            list_push(next_clusters, cid)
            list_push(next_values, val)
        i = i + 1
        
    if !found:
        list_push(next_clusters, cluster_id)
        list_push(next_values, amount)
        
    return MeridianCRDT(next_clusters, next_values, c.n_clusters, c.n_values)

def meridian_crdt_dec(c: MeridianCRDT, cluster_id: Int, amount: Int) -> MeridianCRDT:
    mut next_clusters := list_new()
    mut next_values := list_new()
    mut found := false
    
    mut i := 0
    while i < list_len(c.n_clusters):
        cid := c.n_clusters[i]
        val := c.n_values[i]
        if cid == cluster_id:
            list_push(next_clusters, cid)
            list_push(next_values, val + amount)
            found = true
        else:
            list_push(next_clusters, cid)
            list_push(next_values, val)
        i = i + 1
        
    if !found:
        list_push(next_clusters, cluster_id)
        list_push(next_values, amount)
        
    return MeridianCRDT(c.p_clusters, c.p_values, next_clusters, next_values)

def meridian_crdt_value(c: MeridianCRDT) -> Int:
    mut p_sum := 0
    mut i := 0
    while i < list_len(c.p_values):
        p_sum = p_sum + c.p_values[i]
        i = i + 1
        
    mut n_sum := 0
    mut j := 0
    while j < list_len(c.n_values):
        n_sum = n_sum + c.n_values[j]
        j = j + 1
        
    return p_sum - n_sum

def meridian_crdt_merge(c1: MeridianCRDT, c2: MeridianCRDT) -> MeridianCRDT:
    mut res := c1
    mut i := 0
    while i < list_len(c2.p_clusters):
        cid := c2.p_clusters[i]
        val := c2.p_values[i]
        res = meridian_crdt_inc(res, cid, val)
        i = i + 1
    mut j := 0
    while j < list_len(c2.n_clusters):
        cid := c2.n_clusters[j]
        val := c2.n_values[j]
        res = meridian_crdt_dec(res, cid, val)
        j = j + 1
    return res

# 3. Dense Sorted Set (ZSet)
struct MeridianZSet:
    scores:  List[Int]
    members: List[Str]

def meridian_zset_new() -> MeridianZSet:
    return MeridianZSet(list_new(), list_new())

def meridian_zset_add(zset: MeridianZSet, score: Int, member: Str) -> MeridianZSet:
    mut next_scores := list_new()
    mut next_members := list_new()
    mut inserted := false
    
    mut i := 0
    while i < list_len(zset.members):
        s := zset.scores[i]
        m := zset.members[i]
        if m != member:
            if !inserted && score < s:
                list_push(next_scores, score)
                list_push(next_members, member)
                inserted = true
            list_push(next_scores, s)
            list_push(next_members, m)
        i = i + 1
        
    if !inserted:
        list_push(next_scores, score)
        list_push(next_members, member)
        
    return MeridianZSet(next_scores, next_members)

def meridian_zset_rank(zset: MeridianZSet, member: Str) -> Int:
    mut i := 0
    while i < list_len(zset.members):
        if zset.members[i] == member:
            return i
        i = i + 1
    return -1

def meridian_zset_score(zset: MeridianZSet, member: Str) -> Int:
    mut i := 0
    while i < list_len(zset.members):
        if zset.members[i] == member:
            return zset.scores[i]
        i = i + 1
    return -1

def meridian_zset_range(zset: MeridianZSet, min_score: Int, max_score: Int) -> List[Str]:
    mut res := list_new()
    mut i := 0
    while i < list_len(zset.members):
        s := zset.scores[i]
        if s >= min_score && s <= max_score:
            list_push(res, zset.members[i])
        i = i + 1
    return res

# 4. Quantized Embedding Vector Index
struct MeridianVectorIndex:
    ids: List[Int]
    v0:  List[Int]
    v1:  List[Int]
    v2:  List[Int]
    v3:  List[Int]

def meridian_vec_new() -> MeridianVectorIndex:
    return MeridianVectorIndex(list_new(), list_new(), list_new(), list_new(), list_new())

def meridian_vec_add(idx: MeridianVectorIndex, id: Int, x: Int, y: Int, z: Int, w: Int) -> MeridianVectorIndex:
    mut next_ids := list_new()
    mut next_v0 := list_new()
    mut next_v1 := list_new()
    mut next_v2 := list_new()
    mut next_v3 := list_new()
    
    mut i := 0
    while i < list_len(idx.ids):
        if idx.ids[i] != id:
            list_push(next_ids, idx.ids[i])
            list_push(next_v0, idx.v0[i])
            list_push(next_v1, idx.v1[i])
            list_push(next_v2, idx.v2[i])
            list_push(next_v3, idx.v3[i])
        i = i + 1
        
    list_push(next_ids, id)
    list_push(next_v0, x)
    list_push(next_v1, y)
    list_push(next_v2, z)
    list_push(next_v3, w)
    
    return MeridianVectorIndex(next_ids, next_v0, next_v1, next_v2, next_v3)

def meridian_vec_search_top1(idx: MeridianVectorIndex, qx: Int, qy: Int, qz: Int, qw: Int) -> Int:
    mut best_id := -1
    mut max_dot := -999999999
    
    mut i := 0
    while i < list_len(idx.ids):
        dot := idx.v0[i] * qx + idx.v1[i] * qy + idx.v2[i] * qz + idx.v3[i] * qw
        if dot > max_dot:
            max_dot = dot
            best_id = idx.ids[i]
        i = i + 1
        
    return best_id

