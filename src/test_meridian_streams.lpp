# samardb MERIDIAN Streams & Pub/Sub Test Suite (L++ Pure Native)
import bytes
import io
import pager
import heap
import btree
import schema
import parser
import exec
import opt
import agg
import wal
import recovery
import concur
import pgwire
import meridian_plugin
import server

def assert_bool(name: Str, actual: Bool, expected: Bool) -> Void:
    if actual == expected:
        print_str(str_concat("  [PASS] ", name))
    else:
        print_str(str_concat("  [FAIL] ", name))

def assert_int(name: Str, actual: Int, expected: Int) -> Void:
    if actual == expected:
        print_str(str_concat("  [PASS] ", name))
    else:
        msg := str_concat("  [FAIL] ", str_concat(name, str_concat(" (expected: ", str_concat(int_to_str(expected), str_concat(", got: ", str_concat(int_to_str(actual), ")"))))))
        print_str(msg)

def assert_str(name: Str, actual: Str, expected: Str) -> Void:
    if str_eq_ci(actual, expected):
        print_str(str_concat("  [PASS] ", name))
    else:
        msg := str_concat("  [FAIL] ", str_concat(name, str_concat(" (expected: '", str_concat(expected, str_concat("', got: '", str_concat(actual, "')"))))))
        print_str(msg)

def main() -> Void:
    print_str("================================================================")
    print_str("   SAMARDB MERIDIAN STREAMS & PUB/SUB TEST SUITE               ")
    print_str("================================================================")

    # ── [1/3] Append-Only Stream Ingestion & MAXLEN Trimming ──────────────────
    print_str("--- [1/3] Testing Stream Ingestion & MAXLEN Trimming ---")
    s0 := meridian_stream_new(3) # MAXLEN = 3

    s1 := meridian_stream_xadd(s0, "event:login:user42")
    s2 := meridian_stream_xadd(s1, "event:checkout:user42")
    s3 := meridian_stream_xadd(s2, "event:payment:user42")

    assert_int("Stream length is 3", meridian_stream_xlen(s3), 3)

    # Insert 4th event -> trims oldest event:login:user42
    s4 := meridian_stream_xadd(s3, "event:ship:user42")
    assert_int("Stream length remains bounded at 3", meridian_stream_xlen(s4), 3)

    range_items := meridian_stream_xrange(s4, 2, 4)
    assert_int("Range [2, 4] contains 3 events", list_len(range_items), 3)
    assert_str("First retained event is checkout", range_items[0], "event:checkout:user42")
    assert_str("Last retained event is ship", range_items[2], "event:ship:user42")

    # ── [2/3] Persistent Consumer Groups & PEL Acknowledgments ────────────────
    print_str("--- [2/3] Testing Consumer Group PEL & Acknowledgments ---")
    g0 := meridian_group_new("order_workers")

    # Worker 1 reads 2 events
    g1 := meridian_group_read(g0, "worker_1", s4, 2)
    assert_int("Worker 1 placed 2 events in PEL", meridian_group_pel_count(g1), 2)
    assert_int("Last delivered ID is 3", g1.last_delivered_id, 3)

    # Worker 1 acknowledges event 2
    g2 := meridian_group_ack(g1, 2)
    assert_int("PEL count dropped to 1 after ACK", meridian_group_pel_count(g2), 1)

    # Worker 2 reads next 1 event
    g3 := meridian_group_read(g2, "worker_2", s4, 1)
    assert_int("PEL count is 2 (event 3 and event 4)", meridian_group_pel_count(g3), 2)

    # Clear all remaining ACKs
    g4 := meridian_group_ack(g3, 3)
    g5 := meridian_group_ack(g4, 4)
    assert_int("PEL is completely cleared (0 pending)", meridian_group_pel_count(g5), 0)

    # ── [3/3] Hierarchical Wildcard Pub/Sub ───────────────────────────────────
    print_str("--- [3/3] Testing Hierarchical Wildcard Pub/Sub Routing ---")
    ps0 := meridian_pubsub_new()
    ps1 := meridian_pubsub_subscribe(ps0, "orders.us.ny", 101)
    ps2 := meridian_pubsub_subscribe(ps1, "orders.us", 202)
    ps3 := meridian_pubsub_subscribe(ps2, "*", 303)
    ps4 := meridian_pubsub_subscribe(ps3, "iot.temperature", 404)

    # Publish to "orders.us.ny" -> matches 101 (exact), 202 (prefix), 303 (all)
    matches_ny := meridian_pubsub_publish(ps4, "orders.us.ny")
    assert_int("Publish to orders.us.ny matched 3 subscribers", list_len(matches_ny), 3)

    # Publish to "iot.temperature" -> matches 404 (exact), 303 (all)
    matches_iot := meridian_pubsub_publish(ps4, "iot.temperature")
    assert_int("Publish to iot.temperature matched 2 subscribers", list_len(matches_iot), 2)

    print_str("================================================================")
    print_str(" [SUCCESS] ALL MERIDIAN STREAMS & PUB/SUB TESTS PASSED 100%!   ")
    print_str("================================================================")
