# samardb-agg: Analytical SQL Aggregations, GROUP BY, HAVING, ORDER BY, and LIMIT
# Implements multi-group reduction (COUNT, SUM, AVG, MIN, MAX), HAVING filters, and sorting.

import bytes
import schema
import parser

# ── Aggregate Function Constants ──────────────────────────────────────────────
def AGG_COUNT() -> Int:
    return 1

def AGG_SUM() -> Int:
    return 2

def AGG_AVG() -> Int:
    return 3

def AGG_MIN() -> Int:
    return 4

def AGG_MAX() -> Int:
    return 5

# ── Sort Direction Constants ──────────────────────────────────────────────────
def ORDER_NONE() -> Int:
    return 0

def ORDER_ASC() -> Int:
    return 1

def ORDER_DESC() -> Int:
    return 2

# ── Group Accumulator Table ───────────────────────────────────────────────────
struct GroupTable:
    group_keys: List[Int]
    counts:     List[Int]
    sums:       List[Int]
    mins:       List[Int]
    maxs:       List[Int]

def group_table_new() -> GroupTable:
    return GroupTable(
        list_new(), list_new(), list_new(), list_new(), list_new()
    )

def group_table_size(gt: GroupTable) -> Int:
    return len(gt.group_keys)

# Accumulate a tuple value into the group bucket
def group_table_accumulate(gt: GroupTable, group_key: Int, val: Int) -> GroupTable:
    n := len(gt.group_keys)
    mut found_idx := -1
    mut i := 0
    while i < n:
        if gt.group_keys[i] == group_key:
            found_idx = i
        i = i + 1

    if found_idx >= 0:
        # Existing group: rebuild lists with updated values
        mut gk := list_new()
        mut gc := list_new()
        mut gs := list_new()
        mut gm := list_new()
        mut gx := list_new()
        mut j := 0
        while j < n:
            list_push(gk, gt.group_keys[j])
            if j == found_idx:
                new_c := gt.counts[j] + 1
                new_s := gt.sums[j] + val
                mut new_min := gt.mins[j]
                if val < new_min:
                    new_min = val
                mut new_max := gt.maxs[j]
                if val > new_max:
                    new_max = val
                list_push(gc, new_c)
                list_push(gs, new_s)
                list_push(gm, new_min)
                list_push(gx, new_max)
            else:
                list_push(gc, gt.counts[j])
                list_push(gs, gt.sums[j])
                list_push(gm, gt.mins[j])
                list_push(gx, gt.maxs[j])
            j = j + 1
        return GroupTable(gk, gc, gs, gm, gx)

    # New group: append new bucket
    mut ngk := list_new()
    mut ngc := list_new()
    mut ngs := list_new()
    mut ngm := list_new()
    mut ngx := list_new()
    mut k := 0
    while k < n:
        list_push(ngk, gt.group_keys[k])
        list_push(ngc, gt.counts[k])
        list_push(ngs, gt.sums[k])
        list_push(ngm, gt.mins[k])
        list_push(ngx, gt.maxs[k])
        k = k + 1
    list_push(ngk, group_key)
    list_push(ngc, 1)
    list_push(ngs, val)
    list_push(ngm, val)
    list_push(ngx, val)
    return GroupTable(ngk, ngc, ngs, ngm, ngx)

# Group value accessors
def group_table_get_count(gt: GroupTable, group_key: Int) -> Int:
    n := len(gt.group_keys)
    mut i := 0
    while i < n:
        if gt.group_keys[i] == group_key:
            return gt.counts[i]
        i = i + 1
    return 0

def group_table_get_sum(gt: GroupTable, group_key: Int) -> Int:
    n := len(gt.group_keys)
    mut i := 0
    while i < n:
        if gt.group_keys[i] == group_key:
            return gt.sums[i]
        i = i + 1
    return 0

def group_table_get_avg(gt: GroupTable, group_key: Int) -> Int:
    c := group_table_get_count(gt, group_key)
    if c == 0:
        return 0
    return group_table_get_sum(gt, group_key) / c

def group_table_get_min(gt: GroupTable, group_key: Int) -> Int:
    n := len(gt.group_keys)
    mut i := 0
    while i < n:
        if gt.group_keys[i] == group_key:
            return gt.mins[i]
        i = i + 1
    return 0

def group_table_get_max(gt: GroupTable, group_key: Int) -> Int:
    n := len(gt.group_keys)
    mut i := 0
    while i < n:
        if gt.group_keys[i] == group_key:
            return gt.maxs[i]
        i = i + 1
    return 0

# ── Global Aggregations (No GROUP BY) ─────────────────────────────────────────
def execute_global_aggregate(records: List[Bytes], target_col: Int, agg_func: Int) -> Int:
    n := len(records)
    if n == 0:
        return 0
    if agg_func == AGG_COUNT():
        return n

    mut total_sum := 0
    mut min_val := record_get_int(records[0], target_col)
    mut max_val := min_val
    mut i := 0
    while i < n:
        val := record_get_int(records[i], target_col)
        total_sum = total_sum + val
        if val < min_val:
            min_val = val
        if val > max_val:
            max_val = val
        i = i + 1

    if agg_func == AGG_SUM():
        return total_sum
    if agg_func == AGG_AVG():
        return total_sum / n
    if agg_func == AGG_MIN():
        return min_val
    if agg_func == AGG_MAX():
        return max_val
    return 0

# ── GROUP BY Execution ────────────────────────────────────────────────────────
def execute_group_by(records: List[Bytes], group_col: Int, target_col: Int) -> GroupTable:
    mut gt := group_table_new()
    n := len(records)
    mut i := 0
    while i < n:
        g_key := record_get_int(records[i], group_col)
        val := record_get_int(records[i], target_col)
        gt = group_table_accumulate(gt, g_key, val)
        i = i + 1
    return gt

# ── HAVING Filter Execution ───────────────────────────────────────────────────
def execute_having_filter(gt: GroupTable, agg_func: Int, op: Int, threshold: Int) -> GroupTable:
    mut fgk := list_new()
    mut fgc := list_new()
    mut fgs := list_new()
    mut fgm := list_new()
    mut fgx := list_new()
    n := len(gt.group_keys)
    mut i := 0
    while i < n:
        mut agg_val := 0
        if agg_func == AGG_COUNT():
            agg_val = gt.counts[i]
        elif agg_func == AGG_SUM():
            agg_val = gt.sums[i]
        elif agg_func == AGG_AVG():
            if gt.counts[i] > 0:
                agg_val = gt.sums[i] / gt.counts[i]
        elif agg_func == AGG_MIN():
            agg_val = gt.mins[i]
        elif agg_func == AGG_MAX():
            agg_val = gt.maxs[i]

        mut matched := false
        if op == OP_EQ() && agg_val == threshold:
            matched = true
        elif op == OP_NEQ() && agg_val != threshold:
            matched = true
        elif op == OP_LT() && agg_val < threshold:
            matched = true
        elif op == OP_LTE() && agg_val <= threshold:
            matched = true
        elif op == OP_GT() && agg_val > threshold:
            matched = true
        elif op == OP_GTE() && agg_val >= threshold:
            matched = true

        if matched:
            list_push(fgk, gt.group_keys[i])
            list_push(fgc, gt.counts[i])
            list_push(fgs, gt.sums[i])
            list_push(fgm, gt.mins[i])
            list_push(fgx, gt.maxs[i])
        i = i + 1

    return GroupTable(fgk, fgc, fgs, fgm, fgx)

# ── ORDER BY Execution ────────────────────────────────────────────────────────
def execute_order_by(rows: List[List[Int]], sort_col: Int, order_dir: Int) -> List[List[Int]]:
    if order_dir == ORDER_NONE():
        return rows
    mut out := list_new()
    n := len(rows)
    mut i := 0
    while i < n:
        list_push(out, rows[i])
        i = i + 1

    mut a := 0
    while a < n:
        mut b := 0
        while b < n - 1 - a:
            row_a := out[b]
            row_b := out[b + 1]
            val_a := row_a[sort_col]
            val_b := row_b[sort_col]
            mut need_swap := false
            if order_dir == ORDER_ASC() && val_a > val_b:
                need_swap = true
            elif order_dir == ORDER_DESC() && val_a < val_b:
                need_swap = true

            if need_swap:
                mut swapped := list_new()
                mut k := 0
                while k < n:
                    if k == b:
                        list_push(swapped, row_b)
                    elif k == b + 1:
                        list_push(swapped, row_a)
                    else:
                        list_push(swapped, out[k])
                    k = k + 1
                out = swapped
            b = b + 1
        a = a + 1
    return out

# ── LIMIT & OFFSET Windowing ──────────────────────────────────────────────────
def execute_limit_offset(rows: List[List[Int]], limit: Int, offset: Int) -> List[List[Int]]:
    mut out := list_new()
    n := len(rows)
    mut start_idx := offset
    if start_idx < 0:
        start_idx = 0
    mut count := 0
    mut i := start_idx
    while i < n && count < limit:
        list_push(out, rows[i])
        count = count + 1
        i = i + 1
    return out

# ── DISTINCT Deduplication ────────────────────────────────────────────────────
def execute_distinct(rows: List[List[Int]], key_col: Int) -> List[List[Int]]:
    mut out := list_new()
    mut seen_keys := list_new()
    n := len(rows)
    mut i := 0
    while i < n:
        row := rows[i]
        key := row[key_col]
        # Check if already seen
        mut seen := false
        mut s := 0
        n_seen := len(seen_keys)
        while s < n_seen:
            if seen_keys[s] == key:
                seen = true
            s = s + 1
        if !seen:
            list_push(seen_keys, key)
            list_push(out, row)
        i = i + 1
    return out
