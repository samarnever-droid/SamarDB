# samardb MERIDIAN Slot Migration & Multi-Region WAN Mesh Test Suite (L++ Pure Native)
import bytes
import io
import pager
import heap
import btree
import schema
import parser
import exec
import opt
import agg
import wal
import recovery
import concur
import pgwire
import meridian_plugin
import server

def assert_bool(name: Str, actual: Bool, expected: Bool) -> Void:
    if actual == expected:
        print_str(str_concat("  [PASS] ", name))
    else:
        print_str(str_concat("  [FAIL] ", name))

def assert_int(name: Str, actual: Int, expected: Int) -> Void:
    if actual == expected:
        print_str(str_concat("  [PASS] ", name))
    else:
        msg := str_concat("  [FAIL] ", str_concat(name, str_concat(" (expected: ", str_concat(int_to_str(expected), str_concat(", got: ", str_concat(int_to_str(actual), ")"))))))
        print_str(msg)

def assert_str(name: Str, actual: Str, expected: Str) -> Void:
    if str_eq_ci(actual, expected):
        print_str(str_concat("  [PASS] ", name))
    else:
        msg := str_concat("  [FAIL] ", str_concat(name, str_concat(" (expected: '", str_concat(expected, str_concat("', got: '", str_concat(actual, "')"))))))
        print_str(msg)

def main() -> Void:
    print_str("================================================================")
    print_str("   SAMARDB MERIDIAN CLUSTER MIGRATION & WAN MESH SUITE         ")
    print_str("================================================================")

    # ── [1/2] Zero-Downtime 3-Phase Cluster Slot Migration ────────────────────
    print_str("--- [1/2] Testing 16,384 Slot Routing & Live Migration ---")
    c0 := meridian_cluster_new(1) # Default owner: Node 1

    # Assign Slots 0..5000 to Node 1, 5001..10000 to Node 2
    c1 := meridian_cluster_assign_range(c0, 0, 5000, 1)
    c2 := meridian_cluster_assign_range(c1, 5001, 10000, 2)

    assert_int("Slot 100 routes to Node 1", meridian_cluster_route_slot(c2, 100), 1)
    assert_int("Slot 6000 routes to Node 2", meridian_cluster_route_slot(c2, 6000), 2)

    # Start live migration of Slot 100 from Node 1 -> Node 3
    c_migrating := meridian_cluster_start_migration(c2, 100, 3)
    assert_int("Migrating slot 100 dynamically redirects to target Node 3 (ASK)", meridian_cluster_route_slot(c_migrating, 100), 3)

    # Commit atomic cutover
    c_cutover := meridian_cluster_commit_cutover(c_migrating, 100)
    assert_int("After cutover, Slot 100 is stably owned by Node 3", meridian_cluster_route_slot(c_cutover, 100), 3)

    # ── [2/2] Multi-Region Active-Active WAN Conflict Resolution ──────────────
    print_str("--- [2/2] Testing Multi-Region Active-Active WAN Mesh ---")
    w_us := meridian_wan_new(1) # Region 1 (US)
    w_eu := meridian_wan_new(2) # Region 2 (EU)

    # US writes user:42 status = "online" at timestamp 1000
    w_us1 := meridian_wan_put(w_us, "user:42", "online", 1000)

    # Replicate to EU
    w_eu1 := meridian_wan_put(w_eu, "user:42", "online", 1000)
    assert_str("EU converged to US value", meridian_wan_get(w_eu1, "user:42"), "online")

    # EU performs concurrent update at timestamp 2000 (status = "in_game")
    w_eu2 := meridian_wan_put(w_eu1, "user:42", "in_game", 2000)

    # Replicate EU update to US -> LWW adopts newer timestamp 2000!
    w_us2 := meridian_wan_put(w_us1, "user:42", "in_game", 2000)
    assert_str("US adopted higher-timestamp EU update (in_game)", meridian_wan_get(w_us2, "user:42"), "in_game")

    # Attempt to write stale update with timestamp 500 -> Must be rejected!
    w_us3 := meridian_wan_put(w_us2, "user:42", "stale_offline", 500)
    assert_str("Stale update dropped -> value remains in_game", meridian_wan_get(w_us3, "user:42"), "in_game")

    print_str("================================================================")
    print_str(" [SUCCESS] ALL MERIDIAN CLUSTER & WAN TESTS PASSED 100%!        ")
    print_str("================================================================")
